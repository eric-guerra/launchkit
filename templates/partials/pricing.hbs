<section class="pricing" id="{{#if id}}{{id}}{{else}}pricing{{/if}}">
  <div class="container">
    {{#if heading}}<h2>{{heading}}</h2>{{/if}}
    <div class="grid cols-{{plans.length}}">
      {{#each plans}}
      <article class="plan{{#if highlight}} highlight{{/if}}">
        {{#if highlight}}<span class="badge">Most popular</span>{{/if}}
        <h3>{{name}}</h3>
        <p class="amount">{{price amount ../currency}}{{#if period}}<span>/{{period}}</span>{{/if}}</p>
        <ul>{{#each features}}<li>{{this}}</li>{{/each}}</ul>
        <a class="btn {{#if highlight}}btn-primary{{else}}btn-ghost{{/if}}" href="{{#if href}}{{href}}{{else}}#signup{{/if}}">{{#if cta}}{{cta}}{{else}}Get started{{/if}}</a>
      </article>
      {{/each}}
    </div>
  </div>
</section>
